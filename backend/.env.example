# Copy to backend/.env and fill in. The .env file is git-ignored.

# Environment name. "dev" skips nothing extra yet; reserved for later checks.
APP_ENV=dev

# SQLite file, relative to the directory the server is started from.
DATABASE_URL=sqlite:///./ci_debug_agent.db

# Shared secret configured on the GitHub webhook. If empty, signatures are
# not checked, so never leave it empty on a publicly reachable host.
GITHUB_WEBHOOK_SECRET=

# Fine-grained token with read access to Actions and Contents on the repos
# you monitor. Without it, failures are stored but no logs are fetched.
GITHUB_TOKEN=

# Google AI Studio key for the root-cause analysis step.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
